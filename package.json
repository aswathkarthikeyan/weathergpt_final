{
  "name": "weathergpt-backend",
  "version": "1.0.0",
  "description": "WeatherGPT - Weather chat service and agent powered by Google Gemini",
  "type": "module",
  "main": "server.ts",
  "scripts": {
    "dev": "tsx server.ts",
    "lint": "tsc --noEmit",
    "build": "esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs && tsx scripts/generate_static.ts",
    "build:static": "tsx scripts/generate_static.ts",
    "start": "node dist/server.cjs"
  },
  "dependencies": {
    "@google/genai": "latest",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "fast-xml-parser": "^4.5.3",
    "firebase": "^12.19.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.13.9",
    "esbuild": "^0.25.0",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  }
}
